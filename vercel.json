{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "installCommand": "",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/cidro",
      "destination": "/food",
      "permanent": true
    },
    {
      "source": "/es/cidro",
      "destination": "/es/comida",
      "permanent": true
    },
    {
      "source": "/kitchen",
      "destination": "/food",
      "permanent": true
    },
    {
      "source": "/es/cocina",
      "destination": "/es/comida",
      "permanent": true
    },
    {
      "source": "/cowork",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/es/cowork",
      "destination": "/es/trabajo",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(assets|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}